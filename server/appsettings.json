{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting": "Warning",
        "Microsoft.Extensions": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "JwtIssuer": "dot-watcher",
  "JwtAudience": "dot-watcher",
  "JwtAccessTokenMinutes": 525600,
  "JwtClockSkewSeconds": 60,
  "AuthMaxFailedAttempts": 5,
  "AuthLockoutMinutes": 15,
  "AuthAttemptWindowMinutes": 15,
  "AuthMaxTrackedAttempts": 10000,
  "PositionHistoryCount": 3,
  "RecordingsPath": "recordings"
}
