# Settings for `npm run dev:prod`: the simulator against PROD (the only server; one real database).
# Copy to .env.prod.local (gitignored) and fill in the token. Don't put the real token in this file.

VITE_SERVER_URL=https://dot-watcher.skelstar.io/api

# The Session tab's live view and the phones' watch links open the deployed web client.
VITE_CLIENT_URL=https://dot-watcher.skelstar.io

# Prod's admin bearer token (the server's `BearerToken` setting). Needed to switch Go, crew and groups
# on for sim accounts, and to delete sim- accounts.
VITE_BEARER_TOKEN=
