# Optional — overrides the port-derived default below entirely, e.g. to point at a
# non-localhost server. Leave unset to use http://localhost:<VITE_SERVER_PORT>, where
# VITE_SERVER_PORT comes from the repo root's .env (see ../../.env.example) and defaults to 8080.
# VITE_SERVER_URL=http://localhost:8080
VITE_SESSION_CODE=SUNSET23
VITE_BEARER_TOKEN=dev-token

# Optional — where the main web client's own dev server is running, for the Convergence tab's
# embedded live-view iframe. Defaults to Vite's usual client port.
# VITE_CLIENT_URL=http://localhost:5173
