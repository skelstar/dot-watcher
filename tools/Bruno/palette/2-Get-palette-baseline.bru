meta {
  name: 2 Get palette (baseline)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200

}

docs {
  What apps see now: config.palette in the response. Absent means no palette from config or the database.
}
