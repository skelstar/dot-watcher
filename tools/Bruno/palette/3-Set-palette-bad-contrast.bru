meta {
  name: 3 Set palette (bad contrast)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/palette
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "version": 1,
    "goBg": "#6f1a07",
    "goFg": "#7f2a17",
    "goBar": "#af9164",
    "altBg": "#f7f3e3",
    "altFg": "#2b2118",
    "accent": "#af9164",
    "accentInk": "#2b2118",
    "screen": "#ffffff"
  }
}

assert {
  res.status: eq 400
  res.body.error: contains contrast
}

docs {
  GoFg is too close to GoBg, so the server rejects it with a 400.
}
