meta {
  name: 3 Create palette (no name)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/palettes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "version": 1,
    "goBg": "#6f1a07",
    "goFg": "#f7f3e3",
    "goBar": "#af9164",
    "altBg": "#f7f3e3",
    "altFg": "#2b2118",
    "accent": "#af9164",
    "accentInk": "#2b2118",
    "screen": "#ffffff"
  }
}

assert {
  res.status: eq 400
  res.body.error: contains Name
}

docs {
  A saved palette needs a name (400).
}
