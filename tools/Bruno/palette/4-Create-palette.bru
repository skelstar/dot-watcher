meta {
  name: 4 Create palette
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/palettes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "version": 1,
    "name": "Bruno test palette",
    "label": "bruno-1",
    "goBg": "#6f1a07",
    "goFg": "#f7f3e3",
    "goBar": "#af9164",
    "altBg": "#f7f3e3",
    "altFg": "#2b2118",
    "accent": "#af9164",
    "accentInk": "#2b2118",
    "screen": "#ffffff"
  }
}

assert {
  res.status: eq 201
  res.body.palette.name: eq Bruno test palette
  res.body.assignedTo.length: eq 0
}

script:post-response {
  bru.setVar("paletteId", res.body.id);
}

docs {
  Saves a palette and keeps its id for the next steps. It reaches no phone until assigned (step 7).
}
