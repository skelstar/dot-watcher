meta {
  name: 6 Get palette (test version, before assign)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

headers {
  X-App-Version: {{testAppVersion}} (1)
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.config.palette.name: neq Bruno test palette
}

docs {
  A phone on the test version does not see the new palette yet: it is saved but not assigned.
}
