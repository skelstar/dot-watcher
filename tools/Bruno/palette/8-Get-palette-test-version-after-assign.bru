meta {
  name: 8 Get palette (test version, after assign)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

headers {
  X-App-Version: {{testAppVersion}} (1)
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.config.palette.name: eq Bruno test palette
  res.body.config.palette.label: eq bruno-1
}

docs {
  A phone on the test version now gets it.
}
