meta {
  name: 10 Update palette
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/admin/palettes/{{paletteId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "version": 1,
    "name": "Bruno test palette v2",
    "label": "bruno-2",
    "goBg": "#6f1a07",
    "goFg": "#f7f3e3",
    "goBar": "#af9164",
    "altBg": "#f7f3e3",
    "altFg": "#2b2118",
    "accent": "#af9164",
    "accentInk": "#2b2118",
    "screen": "#ffffff"
  }
}

assert {
  res.status: eq 200
  res.body.palette.name: eq Bruno test palette v2
  res.body.assignedTo[0]: eq {{testAppVersion}}
}

docs {
  Replaces the palette. Editing an assigned palette is live for those phones.
}
