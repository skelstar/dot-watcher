# Shared local-dev config, read by start-local.ps1, client/, and tools/simulator/ so they
# always agree on which port the server is running on. Copy this file to `.env` (gitignored)
# in the repo root and change the value if 8080 is already taken on your machine — everything
# else picks up the change automatically, no other files to edit.
VITE_SERVER_PORT=8080
