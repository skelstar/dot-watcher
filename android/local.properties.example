# Copy this file to `local.properties` in this directory (gitignored) and fill in real values.
# Android Studio manages sdk.dir automatically; the rest need to be added by hand.
sdk.dir=/path/to/Android/sdk
LINZ_API_KEY=your_linz_developer_api_key_here
# Only needed for the "device" build variant (running on a real, physically connected phone
# against a dev server on your LAN) — your dev machine's LAN IP, found via `ipconfig getifaddr en0`
# on macOS. Phone and dev machine must be on the same Wi-Fi network. Leave unset for "debug"
# (emulator) or "release" (production) builds.
DEVICE_API_BASE_URL=http://192.168.1.23:8080
