<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 10+ requires this as a separate grant after foreground location is already held
         (see MainActivity's two-step permission flow) — repo root README.md's iOS equivalent is
         allowsBackgroundLocationUpdates, granted as part of the single CLLocationManager prompt. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Required to run LocationTrackingService as a foreground service (Android 8+) and to
         declare its type as "location" (Android 14+, API 34) — see LocationTrackingService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ requires runtime consent to show the tracking notification itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- For the "exempt this app from battery optimization" prompt — see MainActivity. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- allowBackup is off on purpose: the sign-in token lives in a file encrypted with a Keystore
         key that never leaves the device, so a restored copy can never be read (it used to crash the
         app on every launch with AEADBadTagException). See data/AuthTokenStore.kt. -->
    <application
        android:name=".DotWatcherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.DotWatcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DotWatcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Crew links: a tap on https://<web host>/crew/{CODE}, or the camera app scanning a crew
                 QR code (which holds the same link), opens the app on the "Add X to your crew?"
                 confirmation. autoVerify needs https://<host>/.well-known/assetlinks.json to list this
                 app's signing certificate; until it does (or if it is wrong) the links just open in
                 the browser, which shows the web fallback page with the code. Only /crew/ is claimed:
                 /join/ and /code/ links are deliberately not. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="dot-watcher.skelstar.io" />
                <data android:host="dot-watcher-staging.skelstar.io" />
                <data android:pathPrefix="/crew/" />
            </intent-filter>
        </activity>

        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
