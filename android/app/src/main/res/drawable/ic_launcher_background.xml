<?xml version="1.0" encoding="utf-8"?>
<!-- Recreated (as vectors, not a copy of the PNG) from
     ios/DotWatcher/DotWatcher/Assets.xcassets/AppIcon.appiconset/dotwatchr-icon-5a.png: a
     topo-map-style green field with concentric contour rings and dashed trail marks, echoing
     the LINZ topographic basemap the app's own map screen uses. Colors sampled directly from
     the source icon's pixels (background #A6D583; ring/dash olive #6B7A55, picked to read
     clearly against the green without needing an exact pixel-for-pixel ring-color match). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#A6D583"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Concentric contour rings, centered on the foreground badge's position (50,54) — see
         ic_launcher_foreground.xml — like the source icon. -->
    <path
        android:strokeColor="#8DA36E"
        android:strokeWidth="1.2"
        android:pathData="M50,24 a30,30 0 1,1 -0.1,0 z" />
    <path
        android:strokeColor="#8DA36E"
        android:strokeWidth="1.2"
        android:pathData="M50,10 a44,44 0 1,1 -0.1,0 z" />
    <path
        android:strokeColor="#8DA36E"
        android:strokeWidth="1.2"
        android:pathData="M50,-4 a58,58 0 1,1 -0.1,0 z" />

    <!-- Dashed trail marks along the outer rings' lower-left arc, matching the source icon's
         dashed path motif. -->
    <path
        android:strokeColor="#6B7A55"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M10,90 l6,-7 M4,102 l6,-7 M18,80 l6,-7 M26,70 l6,-7" />
</vector>
